{
  "expo": {
    "name": "OdebraćTelefon",
    "slug": "odebrac-telefon-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F2937"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.adrian.odebractelefon"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F2937"
      },
      "package": "com.adrian.odebractelefon",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "READ_CALL_LOG"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
    [
      "expo-contacts",
      {
        "contactsPermission": "Aplikacja wymaga dostępu do kontaktów"
      }
    ],
    "expo-notifications"
    ],
    "extra": {
      "apiUrl": "https://spamcalldetectbackend.vercel.app"
    },
    "scheme": "odebractelefon"
  }
}
